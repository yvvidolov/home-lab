# MINIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT_API=9000
MINIO_PORT_CONSOLE=9001
MINIO_HOST_PATH=./container/minio_data

# CLICKHOUSE
CLICKHOUSE_ADMIN_USERNAME=clickhouse_admin
CLICKHOUSE_ADMIN_PASSWORD=admin_password
CLICKHOUSE_PORT_HTTP=8001
CLICKHOUSE_PORT_TCP=8002
CLICKHOUSE_PORT_TLS=8003
CLICKHOUSE_TABIX_PORT=8004
CLICKHOUSE_HOST_PATH=./container/clickhouse

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=test
POSTGRES_PORT=5432
POSTGRES_HOST_PATH=./container/postgres

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=adminpass
PGADMIN_PORT=8080
PGADMIN_HOST_PATH=./container/pgadmin
