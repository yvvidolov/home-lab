# MINIO
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z # still has admin panel
MINIO_ROOT_USER=[CHANGE_ME]
MINIO_ROOT_PASSWORD=[CHANGE_ME]
MINIO_PORT_API=9000
MINIO_PORT_CONSOLE=9001
MINIO_HOST_PATH=./container/minio_data

# REDIS
REDIS_VERSION=8.2
REDIS_PORT=6379
REDIS_HOST_PATH=./container/redis
REDIS_MAX_MEMORY=512mb
REDIS_EVICTION_POLICY=allkeys-lfu

# CLICKHOUSE
CLICKHOUSE_VERSION=lts-jammy
CLICKHOUSE_ADMIN_USERNAME=[CHANGE_ME]
CLICKHOUSE_ADMIN_PASSWORD=[CHANGE_ME]
CLICKHOUSE_PORT_HTTP=8001
CLICKHOUSE_PORT_TCP=8002
CLICKHOUSE_PORT_TLS=8003
CLICKHOUSE_TABIX_PORT=8004
CLICKHOUSE_HOST_PATH=./container/clickhouse

# PostgreSQL
POSTGRES_VERSION=18
POSTGRES_USER=[CHANGE_ME]
POSTGRES_PASSWORD=[CHANGE_ME]
POSTGRES_DB=test
POSTGRES_PORT=5432
POSTGRES_HOST_PATH=./container/postgres

# pgAdmin
PGADMIN_DEFAULT_EMAIL=[CHANGE_ME]
PGADMIN_DEFAULT_PASSWORD=[CHANGE_ME]
PGADMIN_PORT=8080
PGADMIN_HOST_PATH=./container/pgadmin
